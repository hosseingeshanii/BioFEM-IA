#!/usr/bin/env python3
"""biofem - BioFEM-IA solver CLI launcher. The code lives in <repo>/python/biofem."""
import os
import sys
from pathlib import Path

_BIN = Path(__file__).resolve().parent          # follows the ~/.local/bin symlink into the repo
os.environ.setdefault("BIOFEM_BIN_DIR", str(_BIN))
sys.path.insert(0, str(_BIN.parent / "python"))

from biofem.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
